{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteAndCountWishesOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-2:YOUR_ACCOUNT_ID:table/diwali_wishes"
    },
    {
      "Sid": "CountPageOpensOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:UpdateItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-2:YOUR_ACCOUNT_ID:table/diwali_metrics"
    }
  ]
}
